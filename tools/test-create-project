#!/bin/sh
# Tests for create-project. Uses local archives; nothing is downloaded.
#
#   sh tools/test-create-project

set -eu

script=$(cd "$(dirname "$0")/.." && pwd -P)/create-project
work=$(mktemp -d)
trap 'rm -rf "$work"' EXIT
failures=0

pass() { echo "ok   $1"; }
fail() { echo "FAIL $1" >&2; failures=$((failures + 1)); }

# A GitHub-style archive: one top-level folder with the template inside.
mkdir -p "$work/source/tracezilla-woocommerce-php-main/bin" \
    "$work/source/tracezilla-integrations-main/tracezilla-woocommerce-sandbox"
template="$work/source/tracezilla-woocommerce-php-main"
printf 'WOOCOMMERCE_URL=http://host.docker.internal:8080\n# Exact name of your company'"'"'s own partner in tracezilla. The seed\n# adds its warehouse location to this partner.\nTRACEZILLA_OWN_COMPANY=\n' > "$template/.env.example"
# The seed's command, which a project gets unless --without-seed is given,
# and a project's own seed file.
mkdir -p "$template/seeds"
printf '#!/bin/sh\n' > "$template/bin/seed-tracezilla"
chmod +x "$template/bin/seed-tracezilla"
printf 'version: 1\n' > "$template/seeds/tracezilla.yaml"
printf '#!/bin/sh\n' > "$work/source/tracezilla-woocommerce-php-main/check-connection"
chmod +x "$work/source/tracezilla-woocommerce-php-main/check-connection"
printf 'services: {}\n' > "$work/source/tracezilla-integrations-main/tracezilla-woocommerce-sandbox/compose.yaml"
tar -czf "$work/integration.tar.gz" -C "$work/source" tracezilla-woocommerce-php-main
tar -czf "$work/umbrella.tar.gz" -C "$work/source" tracezilla-integrations-main

mkdir "$work/projects"
cd "$work/projects"

create() {
    archive=$1
    shift
    TRACEZILLA_TEMPLATE_ARCHIVE="file://$work/$archive" sh "$script" "$@"
}

# Creates a plain project with its own .env.
if create integration.tar.gz woocommerce YOUR_INTEGRATION_NAME >/dev/null 2>&1 \
    && [ -x YOUR_INTEGRATION_NAME/check-connection ] \
    && [ ! -e YOUR_INTEGRATION_NAME/.git ] \
    && [ "$(cat YOUR_INTEGRATION_NAME/.env)" = "$(cat "$template/.env.example"; printf '\nTRACEZILLA_DOCKER_UID=%s\nTRACEZILLA_DOCKER_GID=%s' "$(id -u)" "$(id -g)")" ]; then
    pass "creates a WooCommerce project without Git and with .env"
else
    fail "creates a WooCommerce project without Git and with .env"
fi

# Includes the seed by default, with its setting in .env.
if [ -x YOUR_INTEGRATION_NAME/bin/seed-tracezilla ] \
    && [ -f YOUR_INTEGRATION_NAME/seeds/tracezilla.yaml ] \
    && grep -q '^TRACEZILLA_OWN_COMPANY=' YOUR_INTEGRATION_NAME/.env; then
    pass "includes the seed by default"
else
    fail "includes the seed by default"
fi

# Leaves the seed out with --without-seed, wherever the option is given.
if create integration.tar.gz --without-seed woocommerce WithoutSeed >/dev/null 2>&1 \
    && [ ! -e WithoutSeed/bin/seed-tracezilla ] \
    && [ ! -e WithoutSeed/seeds ] \
    && ! grep -q OWN_COMPANY WithoutSeed/.env; then
    pass "leaves the seed out with --without-seed"
else
    fail "leaves the seed out with --without-seed"
fi

# Takes only the sandbox folder out of the workspace archive.
if create umbrella.tar.gz woocommerce-sandbox my-sandbox >/dev/null 2>&1 \
    && [ -f my-sandbox/compose.yaml ] \
    && [ ! -e my-sandbox/.env ]; then
    pass "creates the WooCommerce sandbox"
else
    fail "creates the WooCommerce sandbox"
fi

refuses() {
    description=$1
    expected=$2
    shift 2
    if output=$(create integration.tar.gz "$@" 2>&1); then
        fail "$description (it succeeded)"
    elif printf '%s' "$output" | grep -q -- "$expected"; then
        pass "$description"
    else
        fail "$description (got: $output)"
    fi
}

refuses "refuses an existing folder" "already exists" woocommerce YOUR_INTEGRATION_NAME
refuses "refuses an unknown platform" "Platforms:" magento Shop
refuses "refuses an unknown option" "Usage:" woocommerce Other --with-everything
refuses "refuses a third name" "Usage:" woocommerce One Two
refuses "refuses a missing project name" "Usage:" woocommerce
refuses "refuses a name starting with a dash" "must start with" woocommerce -x
refuses "refuses a name with spaces" "use only" woocommerce "My Integration"
refuses "refuses a missing parent folder" "does not exist" woocommerce missing/Project

mkdir -p repository/.git repository/sub
refuses "refuses a project inside a Git repository" "is a Git repository" woocommerce repository/sub/Project
[ ! -e repository/sub/Project ] || fail "left a project inside the Git repository"

# The real templates, so the tests see their actual .env.example. They are
# next to this repository in the BifrostConnect workspace; CI clones them
# into TRACEZILLA_TEMPLATES_DIR.
templates=${TRACEZILLA_TEMPLATES_DIR:-$(dirname "$script")/..}

# Only the owner may read .env, because it holds the credentials.
readable_only_by_owner() {
    case "$(ls -l "$1")" in
        -rw-------*) return 0 ;;
        *) return 1 ;;
    esac
}

for platform in woocommerce shopify; do
    repository=tracezilla-$platform-php
    if [ ! -d "$templates/$repository/.git" ] && [ ! -f "$templates/$repository/.git" ]; then
        fail "$repository not found in $templates (set TRACEZILLA_TEMPLATES_DIR)"
        continue
    fi
    git -C "$templates/$repository" archive --prefix="$repository-main/" HEAD | gzip > "$work/$platform.tar.gz"

    if create "$platform.tar.gz" "$platform" "Real-$platform" >/dev/null 2>&1 \
        && grep -q '^TRACEZILLA_OWN_COMPANY=' "Real-$platform/.env" \
        && grep -q '^TRACEZILLA_SEED_ALLOWED_TEAM=' "Real-$platform/.env" \
        && readable_only_by_owner "Real-$platform/.env"; then
        pass "creates a $platform project whose .env only the owner can read"
    else
        fail "creates a $platform project whose .env only the owner can read"
    fi

    # The comments above the seed's settings mention the own partner and the
    # seed itself.
    if create "$platform.tar.gz" "$platform" "Real-$platform-without-seed" --without-seed >/dev/null 2>&1 \
        && [ ! -e "Real-$platform-without-seed/bin/seed-tracezilla" ] \
        && ! grep -q 'OWN_COMPANY\|SEED_ALLOWED_TEAM' "Real-$platform-without-seed/.env.example" \
        && ! grep -q -i 'partner\|seed' "Real-$platform-without-seed/.env.example" \
        && grep -q '^TRACEZILLA_TEAM_SLUG=' "Real-$platform-without-seed/.env.example"; then
        pass "removes the seed settings and their whole comments from the $platform .env"
    else
        fail "removes the seed settings and their whole comments from the $platform .env"
    fi
done

if [ "$failures" -gt 0 ]; then
    echo "$failures test(s) failed." >&2
    exit 1
fi
echo "All tests passed."
