#!/bin/sh
# Create a new BifrostConnect project on this computer.
#
#   curl -fsSL https://happy-bananas.github.io/tracezilla-integrations-docs/create-project | sh -s -- <platform> <project> [--without-seed]
#
# Platforms: shopify, woocommerce, woocommerce-sandbox.
# The project includes the tracezilla seed command and its test data.
# --without-seed leaves them out, for a project that never uses a development
# company.
#
# Windows PowerShell has no sh, so there the script runs in a container:
#
#   docker run --rm -v "${PWD}:/work" -w /work alpine:3 sh -c "wget -qO- https://happy-bananas.github.io/tracezilla-integrations-docs/create-project | sh -s -- <platform> <project>"
#
# The project is a plain folder without Git history or a link back to the
# template. It is never created inside a Git repository. Only curl or wget, and
# tar are needed.

set -eu

usage() {
    echo "Usage: create-project <platform> <project> [--without-seed]" >&2
    echo "Platforms: shopify, woocommerce, woocommerce-sandbox" >&2
    echo "--without-seed: leave out the tracezilla seed (test data for a development company)" >&2
    echo "Example:   create-project woocommerce YOUR_INTEGRATION_NAME" >&2
}

fail() {
    echo "Cannot create project: $1" >&2
    exit 2
}

platform=
project=
with_seed=yes
for argument in "$@"; do
    case "$argument" in
        --without-seed) with_seed=no ;;
        --*) usage; exit 2 ;;
        *)
            if [ -z "$platform" ]; then
                platform=$argument
            elif [ -z "$project" ]; then
                project=$argument
            else
                usage
                exit 2
            fi
            ;;
    esac
done
if [ -z "$platform" ] || [ -z "$project" ]; then
    usage
    exit 2
fi
github=https://github.com/Happy-Bananas

# Each platform is a repository, or a folder inside one, plus what the project
# needs after unpacking.
case "$platform" in
    shopify)
        repository=tracezilla-shopify-php
        folder=
        label="Shopify integration"
        ;;
    woocommerce)
        repository=tracezilla-woocommerce-php
        folder=
        label="WooCommerce integration"
        ;;
    woocommerce-sandbox)
        repository=tracezilla-integrations
        folder=tracezilla-woocommerce-sandbox
        label="WooCommerce sandbox"
        ;;
    *)
        usage
        exit 2
        ;;
esac

# Tests replace the download with a local archive.
archive=${TRACEZILLA_TEMPLATE_ARCHIVE:-$github/$repository/archive/refs/heads/main.tar.gz}

name=$(basename -- "$project")
case "$name" in
    [A-Za-z0-9]*) ;;
    *) fail "the name must start with a letter or digit: $name" ;;
esac
case "$name" in
    *[!A-Za-z0-9._-]*) fail "use only letters, digits, '.', '_' and '-' in the name: $name" ;;
esac

if [ -e "$project" ]; then
    fail "$project already exists."
fi

parent=$(dirname -- "$project")
if [ ! -d "$parent" ]; then
    fail "the folder $parent does not exist."
fi

# A project belongs to the consultant or customer, never to another repository
# such as the BifrostConnect workspace.
directory=$(cd "$parent" && pwd -P)
while :; do
    if [ -e "$directory/.git" ]; then
        fail "$directory is a Git repository. Create the project outside it."
    fi
    [ "$directory" = / ] && break
    directory=$(dirname "$directory")
done

command -v tar >/dev/null 2>&1 || fail "tar is required."
if command -v curl >/dev/null 2>&1; then
    download() { curl -fsSL "$1"; }
elif command -v wget >/dev/null 2>&1; then
    download() { wget -qO- "$1"; }
else
    fail "curl or wget is required."
fi

temporary=$(mktemp -d)
trap 'rm -rf "$temporary"' EXIT

echo "Creating $label in $project ..."
download "$archive" | tar -xz -C "$temporary"

# GitHub archives contain one top-level folder, e.g. tracezilla-shopify-php-main.
source=$(find "$temporary" -mindepth 1 -maxdepth 1 -type d)
if [ -n "$folder" ]; then
    source=$source/$folder
fi
if [ ! -d "$source" ]; then
    fail "the downloaded template does not contain $folder."
fi
mv "$source" "$project"

# The seed only fills a development company with test data. A project that
# works directly on production data leaves it out. The sandbox has no seed.
if [ "$platform" != woocommerce-sandbox ] && [ "$with_seed" = no ]; then
    rm -rf "$project/bin/seed-tracezilla" "$project/src/Seed" "$project/seeds" "$project/tests/Unit/Seed"
    # TRACEZILLA_OWN_COMPANY and its comment are only used by the seed.
    if [ -f "$project/.env.example" ]; then
        grep -v -e '^TRACEZILLA_OWN_COMPANY=' -e 'own partner in tracezilla' -e 'adds its warehouse location' \
            "$project/.env.example" > "$project/.env.example.new" || true
        mv "$project/.env.example.new" "$project/.env.example"
    fi
fi

if [ -f "$project/.env.example" ]; then
    cp "$project/.env.example" "$project/.env"
    # Containers run as this user, so the files they create belong to you. In
    # the Windows container the user is root; the default user is used then.
    if [ "$(id -u)" != 0 ]; then
        printf '\nTRACEZILLA_DOCKER_UID=%s\nTRACEZILLA_DOCKER_GID=%s\n' "$(id -u)" "$(id -g)" >> "$project/.env"
    fi
fi

echo ""
echo "Your $label is ready in $project."
echo ""
echo "Next:"
echo "  cd $project"
if [ "$platform" = woocommerce-sandbox ]; then
    echo "  docker compose up -d"
else
    echo "  Edit .env"
    echo "  ./check-connection     (Windows: see the install guide)"
fi
